# Handles red life regeneration
# Tag mode red life handled by tag.zss

#===============================================================================
# Global states
#===============================================================================
[StateDef -2]

if teamMode != Tag {
	# Initialize variables
	if roundState = 0 {
		map(_iksys_redLifeTimer) := 0;
	}

	if roundState = 2 && alive {
		# Decrease cooldown timer
		if map(_iksys_redLifeTimer) > 0 {
			mapAdd{map: "_iksys_redLifeTimer"; value: -1}
		}

		# Set cooldown timer while getting hit
		if moveType = H || stateNo = const(StateDownedGetHit_gettingUp) {
			map(_iksys_redLifeTimer) := 60;
		}

		# Red Life regeneration
		# TODO: Split constant from tag. Maybe just "hardcode" it
		if map(_iksys_redLifeTimer) <= 0 && life < redLife && (gameTime % const(TagRedLifeRegenFrames)) = 0 { # every 30 frames (0.5s) by default
			lifeAdd{value: min(redLife - life, ceil(lifeMax * const(TagRedLifeRegenPercent))); absolute: 1} # 0.5% lifeMax by default
		}
	}
}
